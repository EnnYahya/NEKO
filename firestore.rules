// ============================================================
// FIRESTORE SECURITY RULES
// ============================================================
// Copy this entire file's content into:
// Firebase Console > Firestore Database > Rules tab > paste > Publish
// Without this, by default Firebase blocks everything (safe but broken),
// or if you started in "test mode," anyone can read/write everything (unsafe).
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only for the account whose users/{uid} doc has isAdmin: true —
    // set automatically at signup for the account named exactly "admin".
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Usernames collection: anyone logged out can check availability
    // during signup, but only the signup process itself can create one,
    // and nobody can edit/delete a taken username.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // User profiles: anyone can read (needed for a public feed/profile pages),
    // but you can only edit your OWN profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Password reset requests: anyone can create one (that's the point —
    // logged-out users need this), but only you (manually, via the
    // Firebase Console as the project owner) can read them.
    match /password_reset_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if false;
      // Note: as the project OWNER you can always read/manage data directly
      // in the Firebase Console regardless of these rules — these rules only
      // govern what the WEBSITE code is allowed to do.
    }

    // Posts: anyone logged in can read the feed and create posts,
    // but you can only edit/delete YOUR OWN post.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.authorId
         // Allow anyone logged in to bump commentCount by exactly 1
         // (this is what happens when someone adds a comment) —
         // not to an arbitrary number.
         || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
             && request.resource.data.commentCount == resource.data.commentCount + 1));
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.authorId || isAdmin());

      // Comments: anyone logged in can read/add; only the comment's
      // own author can edit/delete it.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      }
    }

    // Conversations: only the two participants can read/write theirs.
    // The "|| !exists(...)" on read lets the app safely check "does this
    // conversation exist yet?" before creating a brand-new one — without
    // it, checking a not-yet-created doc throws a permission error instead
    // of a clean "doesn't exist" (this was the original bug behind
    // "Missing or insufficient permissions" when starting a first-time chat).
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId))
         || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages: only the two participants of the parent conversation
      // can read them, and you can only send messages as yourself.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }
    // Chess matches: only the two players in a match can read or update it.
    // Either player can create a challenge (as long as they list themselves
    // as one of the two players) and either player can update the board as
    // the game is played. This trusts both players not to tamper with the
    // board directly — fine for a friends app, same trust level as the
    // commentCount rule above.
    match /chess_matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.players;
      allow update: if request.auth != null && request.auth.uid in resource.data.players;
      allow delete: if false;
    }
  }
}
